#!/usr/bin/env bash
# Working Corpus 启动脚本。插件的钩子、MCP 连接器、npm link 之后的 corpus 命令都走这里。
# 插件缓存里没有 node_modules，第一次运行时先装依赖（只有 zod 一个）。
set -euo pipefail
SELF="${BASH_SOURCE[0]}"
if command -v realpath >/dev/null 2>&1; then SELF="$(realpath "$SELF")"; fi
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
if [ ! -d "$ROOT/node_modules/zod" ]; then
  if ! (cd "$ROOT" && npm install --omit=dev --no-audit --no-fund --silent) >/dev/null 2>&1; then
    echo "Working Corpus：安装依赖失败，请在 $ROOT 手动运行 npm install" >&2
    exit 1
  fi
fi
exec node --no-warnings "$ROOT/src/cli.ts" "$@"
